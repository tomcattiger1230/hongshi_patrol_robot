<?xml version="1.0" encoding="UTF-8" ?>
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>robot320_udp</transport_id>
        <type>UDPv4</type>
        <interfaceWhiteList>
          <address>@ROBOT320_LAN_ADDRESS@</address>
        </interfaceWhiteList>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="robot320_lan" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>robot320_udp</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
