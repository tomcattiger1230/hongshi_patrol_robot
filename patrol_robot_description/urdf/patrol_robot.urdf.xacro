<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="patrol_robot">
  <!-- roboQ-320 dimensions from the vehicle configuration sheet. -->
  <xacro:property name="wheel_radius" value="0.215"/>
  <xacro:property name="wheel_width" value="0.135"/>
  <xacro:property name="wheel_base" value="0.70"/>
  <xacro:property name="track_width" value="0.825"/>
  <xacro:property name="steering_joint_limit" value="${radians(35.0)}"/>
  <!-- Bicycle-model limit atan(wheel_base / minimum_turning_radius). -->
  <xacro:property name="steering_control_limit" value="${atan2(wheel_base, 2.35)}"/>
  <!--
    MID-360 installation in base_footprint coordinates. The measured vehicle
    envelope is 1.53 m long and 0.78 m wide: 0.365 m to the front,
    1.165 m to the rear, and 0.39 m to either side.
  -->
  <xacro:property name="mid360_x" value="0.40"/>
  <xacro:property name="mid360_y" value="0.0"/>
  <xacro:property name="mid360_z" value="1.50"/>

  <material name="body_blue">
    <color rgba="0.08 0.32 0.70 1.0"/>
  </material>
  <material name="dark">
    <color rgba="0.05 0.05 0.06 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.65 0.68 0.72 1.0"/>
  </material>
  <material name="sensor_green">
    <color rgba="0.10 0.80 0.35 1.0"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.29"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="1.54 0.70 0.34"/>
      </geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="1.54 0.70 0.34"/>
      </geometry>
    </collision>
    <inertial>
      <!-- 170.4 kg chassis + four 2.3 kg wheels + two 0.2 kg steering
           carriers = 180 kg total vehicle mass. -->
      <mass value="170.4"/>
      <inertia ixx="8.59952" ixy="0.0" ixz="0.0"
               iyy="35.31824" iyz="0.0" izz="40.63472"/>
    </inertial>
  </link>

  <xacro:macro name="wheel_link" params="name">
    <link name="${name}">
      <visual>
        <origin rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <origin rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="2.3"/>
        <inertia ixx="0.0272" ixy="0.0" ixz="0.0"
                 iyy="0.0532" iyz="0.0" izz="0.0272"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="rear_wheel" params="side y">
    <xacro:wheel_link name="rear_${side}_wheel_link"/>
    <joint name="rear_${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="rear_${side}_wheel_link"/>
      <origin xyz="${-wheel_base / 2.0} ${y} -0.075"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.02"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="front_wheel" params="side y">
    <link name="front_${side}_steering_link">
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.0002" ixy="0.0" ixz="0.0"
                 iyy="0.0002" iyz="0.0" izz="0.0002"/>
      </inertial>
    </link>
    <joint name="front_${side}_steering_joint" type="revolute">
      <parent link="base_link"/>
      <child link="front_${side}_steering_link"/>
      <origin xyz="${wheel_base / 2.0} ${y} -0.075"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-steering_joint_limit}" upper="${steering_joint_limit}"
             effort="500.0" velocity="${radians(25.0)}"/>
      <dynamics damping="2.0" friction="0.2"/>
    </joint>
    <xacro:wheel_link name="front_${side}_wheel_link"/>
    <joint name="front_${side}_wheel_joint" type="continuous">
      <parent link="front_${side}_steering_link"/>
      <child link="front_${side}_wheel_link"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.02"/>
    </joint>
  </xacro:macro>

  <xacro:front_wheel side="left" y="${track_width / 2.0}"/>
  <xacro:front_wheel side="right" y="${-track_width / 2.0}"/>
  <xacro:rear_wheel side="left" y="${track_width / 2.0}"/>
  <xacro:rear_wheel side="right" y="${-track_width / 2.0}"/>

  <link name="front_bumper_link">
    <visual>
      <geometry>
        <box size="0.08 0.46 0.08"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.08 0.46 0.08"/>
      </geometry>
    </collision>
  </link>
  <joint name="front_bumper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_bumper_link"/>
    <origin xyz="0.77 0 -0.02"/>
  </joint>

  <link name="mast_link">
    <visual>
      <geometry>
        <cylinder radius="0.045" length="0.93"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.045" length="0.93"/>
      </geometry>
    </collision>
  </link>
  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast_link"/>
    <origin xyz="${mid360_x} ${mid360_y} 0.635"/>
  </joint>

  <link name="sensor_head_link">
    <visual>
      <geometry>
        <sphere radius="0.09"/>
      </geometry>
      <material name="sensor_green"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.09"/>
      </geometry>
    </collision>
  </link>
  <joint name="sensor_head_joint" type="fixed">
    <parent link="mast_link"/>
    <child link="sensor_head_link"/>
    <origin xyz="0 0 0.465"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.07" length="0.08"/>
      </geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="sensor_head_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.11"/>
  </joint>

  <xacro:macro name="wheel_friction" params="link">
    <gazebo reference="${link}">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:wheel_friction link="front_left_wheel_link"/>
  <xacro:wheel_friction link="front_right_wheel_link"/>
  <xacro:wheel_friction link="rear_left_wheel_link"/>
  <xacro:wheel_friction link="rear_right_wheel_link"/>
  <gazebo reference="lidar_link">
    <sensor name="mid360s" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <topic>/livox/lidar_scan</topic>
      <!-- Gazebo Sim uses gz_frame_id for the transport message header. -->
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>900</samples>
            <resolution>1</resolution>
            <min_angle>${-pi}</min_angle>
            <max_angle>${pi}</max_angle>
          </horizontal>
          <vertical>
            <samples>32</samples>
            <resolution>1</resolution>
            <min_angle>-0.122173</min_angle>
            <max_angle>0.907571</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.10</min>
          <max>70.0</max>
          <resolution>0.02</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
      <!-- The real vehicle has a single motor and rear differential. -->
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <kingpin_width>${track_width}</kingpin_width>
      <wheel_base>${wheel_base}</wheel_base>
      <wheel_separation>${track_width}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <steering_limit>${steering_control_limit}</steering_limit>
      <min_velocity>-5.5556</min_velocity>
      <max_velocity>5.5556</max_velocity>
      <min_acceleration>-2.0</min_acceleration>
      <max_acceleration>2.0</max_acceleration>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <joint_name>front_left_steering_joint</joint_name>
      <joint_name>front_right_steering_joint</joint_name>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>
</robot>
