<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="patrol_robot">
  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width" value="0.06"/>
  <xacro:property name="wheel_separation" value="0.46"/>

  <material name="body_blue">
    <color rgba="0.08 0.32 0.70 1.0"/>
  </material>
  <material name="dark">
    <color rgba="0.05 0.05 0.06 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.65 0.68 0.72 1.0"/>
  </material>
  <material name="sensor_green">
    <color rgba="0.10 0.80 0.35 1.0"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.18"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.58 0.40 0.16"/>
      </geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.58 0.40 0.16"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="18.0"/>
      <inertia ixx="0.2784" ixy="0.0" ixz="0.0"
               iyy="0.5424" iyz="0.0" izz="0.7200"/>
    </inertial>
  </link>

  <xacro:macro name="drive_wheel" params="side y">
    <link name="${side}_wheel_link">
      <visual>
        <origin rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <origin rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="1.2"/>
        <inertia ixx="0.0036" ixy="0.0" ixz="0.0"
                 iyy="0.0060" iyz="0.0" izz="0.0036"/>
      </inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${y} -0.08"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.02"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel side="left" y="${wheel_separation / 2.0}"/>
  <xacro:drive_wheel side="right" y="${-wheel_separation / 2.0}"/>

  <link name="caster_link">
    <visual>
      <geometry>
        <sphere radius="0.045"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.045"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.00024" ixy="0.0" ixz="0.0"
               iyy="0.00024" iyz="0.0" izz="0.00024"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="-0.22 0 -0.135"/>
  </joint>

  <link name="front_bumper_link">
    <visual>
      <geometry>
        <box size="0.08 0.46 0.08"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.08 0.46 0.08"/>
      </geometry>
    </collision>
  </link>
  <joint name="front_bumper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_bumper_link"/>
    <origin xyz="0.32 0 -0.02"/>
  </joint>

  <link name="mast_link">
    <visual>
      <geometry>
        <cylinder radius="0.045" length="0.42"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.045" length="0.42"/>
      </geometry>
    </collision>
  </link>
  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast_link"/>
    <origin xyz="-0.08 0 0.29"/>
  </joint>

  <link name="sensor_head_link">
    <visual>
      <geometry>
        <sphere radius="0.09"/>
      </geometry>
      <material name="sensor_green"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.09"/>
      </geometry>
    </collision>
  </link>
  <joint name="sensor_head_joint" type="fixed">
    <parent link="mast_link"/>
    <child link="sensor_head_link"/>
    <origin xyz="0 0 0.25"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.07" length="0.08"/>
      </geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="sensor_head_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.11"/>
  </joint>

  <gazebo reference="left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="caster_link">
    <mu1>0.02</mu1>
    <mu2>0.02</mu2>
  </gazebo>
  <gazebo reference="lidar_link">
    <sensor name="mid360s" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <topic>/livox/lidar_scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>900</samples>
            <resolution>1</resolution>
            <min_angle>${-pi}</min_angle>
            <max_angle>${pi}</max_angle>
          </horizontal>
          <vertical>
            <samples>32</samples>
            <resolution>1</resolution>
            <min_angle>-0.122173</min_angle>
            <max_angle>0.907571</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.10</min>
          <max>70.0</max>
          <resolution>0.02</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>
</robot>
