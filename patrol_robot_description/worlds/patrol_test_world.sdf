<?xml version="1.0"?>
<sdf version="1.9">
  <world name="patrol_test_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.70 0.80 0.92 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>36 32</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>36 32</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.35 0.38 0.42 1</ambient>
            <diffuse>0.45 0.48 0.52 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="inspection_box">
      <static>true</static>
      <pose>6.0 4.0 1.10 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.8 0.8 2.2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.8 0.8 2.2</size></box>
          </geometry>
          <material>
            <ambient>0.75 0.25 0.10 1</ambient>
            <diffuse>0.85 0.30 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="inspection_tank">
      <static>true</static>
      <pose>-4.0 5.0 1.20 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.45</radius><length>2.4</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.45</radius><length>2.4</length></cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.55 0.30 1</ambient>
            <diffuse>0.18 0.65 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Asymmetric perimeter walls give SLAM stable long-range features. -->
    <model name="north_wall">
      <static>true</static>
      <pose>0 12 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>28 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>28 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.62 0.65 0.70 1</ambient>
            <diffuse>0.72 0.75 0.80 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="south_wall">
      <static>true</static>
      <pose>0 -12 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>28 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>28 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.62 0.65 0.70 1</ambient>
            <diffuse>0.72 0.75 0.80 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="east_wall">
      <static>true</static>
      <pose>14 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 24 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 24 2.5</size></box></geometry>
          <material>
            <ambient>0.62 0.65 0.70 1</ambient>
            <diffuse>0.72 0.75 0.80 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="west_wall">
      <static>true</static>
      <pose>-14 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 24 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 24 2.5</size></box></geometry>
          <material>
            <ambient>0.62 0.65 0.70 1</ambient>
            <diffuse>0.72 0.75 0.80 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Interior walls form wide, Ackermann-drivable passages. -->
    <model name="north_corridor_wall">
      <static>true</static>
      <pose>4.0 7.0 1.10 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>9.0 0.18 2.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>9.0 0.18 2.2</size></box></geometry>
          <material>
            <ambient>0.20 0.42 0.72 1</ambient>
            <diffuse>0.24 0.50 0.84 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="west_corridor_wall">
      <static>true</static>
      <pose>-7.0 -2.0 1.10 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.18 7.0 2.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.18 7.0 2.2</size></box></geometry>
          <material>
            <ambient>0.20 0.42 0.72 1</ambient>
            <diffuse>0.24 0.50 0.84 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="east_corridor_wall">
      <static>true</static>
      <pose>8.0 3.0 1.10 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.18 7.0 2.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.18 7.0 2.2</size></box></geometry>
          <material>
            <ambient>0.20 0.42 0.72 1</ambient>
            <diffuse>0.24 0.50 0.84 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="south_corridor_wall">
      <static>true</static>
      <pose>2.0 -6.5 1.10 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.0 0.18 2.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.0 0.18 2.2</size></box></geometry>
          <material>
            <ambient>0.20 0.42 0.72 1</ambient>
            <diffuse>0.24 0.50 0.84 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="central_tank">
      <static>true</static>
      <pose>1.0 -1.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.60</radius><length>2.5</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.60</radius><length>2.5</length></cylinder>
          </geometry>
          <material>
            <ambient>0.45 0.25 0.65 1</ambient>
            <diffuse>0.55 0.32 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="pallet_stack">
      <static>true</static>
      <pose>8.0 -5.0 1.00 0 0 0.25</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.9 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.9 2.0</size></box></geometry>
          <material>
            <ambient>0.68 0.45 0.16 1</ambient>
            <diffuse>0.78 0.52 0.20 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="low_crate">
      <static>true</static>
      <pose>-2.0 -7.0 0.90 0 0 -0.2</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 1.2 1.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 1.2 1.8</size></box></geometry>
          <material>
            <ambient>0.72 0.62 0.12 1</ambient>
            <diffuse>0.82 0.72 0.16 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
