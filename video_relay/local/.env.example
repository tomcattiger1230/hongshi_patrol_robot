SERVER_HOST=203.0.113.10
SERVER_PORT=8554
STREAM_PATH=robot
READ_USER=local_viewer
READ_PASSWORD=change-this-read-password
WEB_HOST=127.0.0.1
WEB_PORT=8081
JPEG_QUALITY=80
RTSP_OPEN_TIMEOUT_MS=5000

# 与 NUC 同一局域网时通过 mDNS 自动解析当前 DHCP 地址；失败后自动回退公网 SERVER_HOST。
LOCAL_SERVER_HOST=hs-nuc14lnk.local
LOCAL_SERVER_PORT=8554
LOCAL_STREAM_PATH=robot
SECOND_LOCAL_STREAM_PATH=robot2
SECOND_CLOUD_STREAM_PATH=robot2

# NUC 的 mDNS 名称；PTZ_TOKEN 必须与 robot/.env 一致。
PTZ_AGENT_URL=http://hs-nuc14lnk.local:8090
PTZ_TOKEN=change-this-independent-ptz-token
# PTZ 公网备用复用 NUC 主动建立的 SSH 反向隧道；通常无需修改。
ROBOT_CLOUD_SSH_HOST=hsjc_ecs
ROBOT_CLOUD_REVERSE_PORT=12220
ROBOT_SSH_HOST_KEY_ALIAS=192.168.88.108
